{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "English Input Assistant",
  "version": "0.1.0",
  "identifier": "com.tetsu.english-input-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "English Input Assistant",
        "width": 520,
        "height": 300,
        "minWidth": 320,
        "minHeight": 200,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https: http://localhost:*; media-src blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg"],
    "resources": ["icons/tray-icon-mac.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QzZEMkFCNTM0MDA1MTgKUldRWUJVQlRxOUxHV1NnK3VUSGxid2JFeFVvcHpsemxJNUhWTmpvWDNTUlpKR0Q0TmNockd3UjkK",
      "endpoints": [
        "https://github.com/t-hamano/english-input-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
